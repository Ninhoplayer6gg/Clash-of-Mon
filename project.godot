; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Clash of Mon"
config/description="Fangame gratuito e não-comercial: arena fighter 2D top-down com sprites do PMDCollab/SpriteCollab."
config/version="0.1.0"
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0.07, 0.09, 0.12, 1)
config/icon="res://icon.svg"

[autoload]

Settings="*res://core/settings.gd"
GameData="*res://core/game_data.gd"
InputActions="*res://input/input_actions.gd"
Audio="*res://audio/audio_manager.gd"
Game="*res://core/game_state.gd"
DebugOverlay="*res://debug/debug_overlay.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_vertices_to_pixel=false
environment/defaults/default_clear_color=Color(0.07, 0.09, 0.12, 1)
